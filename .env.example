# API
API_KEY=dev-api-key-change-me
# Remote / LAN hosting (see docs/REMOTE_ACCESS.md)
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ALLOW_ALL=true
# CORS_ORIGINS=http://192.168.1.10:5173

# GitHub Pages + tunnel (see README — Remote access)
# CORS_GITHUB_PAGES=true
# UI_PASSWORD=your-demo-login-password
# NGROK_BASIC_AUTH=you:your-ngrok-password
DATABASE_URL=postgresql+asyncpg://underwrite:underwrite@localhost:5432/underwrite
REDIS_URL=redis://localhost:6379

# Object storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=underwrite-docs
MINIO_SECURE=false

# LLM (optional — falls back to heuristic mode)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Azure OpenAI (when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Embeddings (local fallback when Azure not set)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Agent limits
MAX_AGENT_STEPS=12

# Local dev: run investigation inline (no ARQ worker required)
# SYNC_INVESTIGATION=true
GEOCODING_USER_AGENT=underwrite-agent/0.1
