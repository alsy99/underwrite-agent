# =============================================================================
# Underwrite Agent — environment template
#   cp .env.example .env
# Repo-root .env is the single source for API, worker, scripts, demo UI.
# .env is gitignored — do not commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — local core (safe defaults work out of the box)
# -----------------------------------------------------------------------------
API_KEY=dev-api-key-change-me
DATABASE_URL=postgresql+asyncpg://underwrite:underwrite@localhost:5432/underwrite
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=underwrite-docs
MINIO_SECURE=false

# ollama | azure | heuristic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MAX_AGENT_STEPS=12
GEOCODING_USER_AGENT=underwrite-agent/0.1

# OSINT_MODE: auto (fixture unless live keys set) | fixture | live
OSINT_MODE=auto
OSINT_FIXTURE_DIR=data/fixtures/osint
# SEC requires a contact User-Agent even for free EDGAR calls
SEC_EDGAR_USER_AGENT="underwrite-agent contact@example.com"

# -----------------------------------------------------------------------------
# OPTIONAL — Azure LLM (only when LLM_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# -----------------------------------------------------------------------------
# OPTIONAL — live OSINT providers (empty = fixture corpus)
# -----------------------------------------------------------------------------
OPENCORPORATES_API_KEY=
NEWS_API_KEY=
OFAC_SDN_PATH=
# Downloaded SDN CSV cache (auto mode may refresh from Treasury)
OSINT_CACHE_DIR=.cache/osint

# -----------------------------------------------------------------------------
# Auth / SSO (api_key | oidc | both)
# -----------------------------------------------------------------------------
AUTH_MODE=both
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_DEV_SECRET=dev-oidc-hs256-change-me
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
API_KEY_DEFAULT_TENANT=default
API_KEY_DEFAULT_ROLES=admin,underwriter,reviewer

# -----------------------------------------------------------------------------
# OPTIONAL — API bind / CORS (scripts + FastAPI)
# API_HOST / API_PORT used by start-api.sh + tunnels (not uvicorn Settings logic)
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
CORS_ALLOW_ALL=false
CORS_GITHUB_PAGES=false
CORS_ORIGIN_REGEX=

# Run investigation in API process (skip Redis worker)
SYNC_INVESTIGATION=false

# -----------------------------------------------------------------------------
# OPTIONAL — remote / internet demo
# -----------------------------------------------------------------------------
# Demo login; start-internet-session.sh also syncs GitHub secret UI_PASSWORD
UI_PASSWORD=
# ngrok tunnel basic auth (user:password) — scripts/tunnel-ngrok.sh
NGROK_BASIC_AUTH=
# 1 = bind 0.0.0.0 + permissive demo CORS helpers in start scripts
REMOTE_ACCESS=0

# -----------------------------------------------------------------------------
# OPTIONAL — Demo UI (Vite). start-demo-ui.sh sources this file.
# Leave VITE_API_URL empty locally → Vite proxies /api → :8000
# VITE_API_KEY should match API_KEY when set
# -----------------------------------------------------------------------------
VITE_API_URL=
VITE_API_KEY=dev-api-key-change-me
VITE_UI_PASSWORD=
VITE_UI_PASSWORD_HASH=
# GitHub Pages sets this in CI; local default /
VITE_BASE_PATH=/
