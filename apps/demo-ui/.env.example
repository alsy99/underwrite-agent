VITE_API_KEY=dev-api-key-change-me
# Optional: direct API URL (default uses Vite proxy /api -> :8000).
# VITE_API_URL=https://your-subdomain.ngrok-free.app
# UI login (local): hash preferred — ./scripts/hash-ui-password.sh 'your-password'
# VITE_UI_PASSWORD_HASH=abc123...
# VITE_UI_PASSWORD=plain-only-for-local-dev
# GitHub Pages base path (CI sets automatically)
# VITE_BASE_PATH=/underwrite-agent/
