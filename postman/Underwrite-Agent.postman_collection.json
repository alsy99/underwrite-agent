            },
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/policies",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "policies"]
            },
            "description": "Requires selecting file manually: click file row → Select Files → pick `postman/fixtures/policies/sba_policy_seed.md`. If you see 422 'file required', use **Upload Policy — SBA (JSON)** instead."
