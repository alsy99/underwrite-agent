      "name": "Policies",
      "item": [
        {
          "name": "Upload Policy — SBA (JSON) ★ use this",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('policyId', j.id);",
                  "pm.environment.set('policyId', j.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"SBA Policy Seed\",\n  \"policy_version\": \"2026.05.1\",\n  \"effective_date\": \"2026-05-21\",\n  \"filename\": \"sba_policy_seed.md\",\n  \"content\": \"# SBA 7(a) Underwriting Policy — Seed Document\\n\\n## INCOME-004 — Allowable Income Sources\\nCryptocurrency mining income, NFT sales proceeds, and unverified digital asset income are **not** allowable income sources for SBA 7(a) qualification unless seasoned for 24 months with full documentation.\\n\\n## SBA-REV-002 — Revenue Reconciliation\\nStated annual gross revenues on SBA Form 1919 must reconcile within **10%** of tax returns, IRS transcripts (4506-C), and profit & loss statements. Material discrepancies require manual review.\\n\\n## SBA-ENTITY-001 — Business Existence\\nThe applicant business must be verifiable through state registry records. Shell companies operating from virtual offices require enhanced due diligence.\\n\\n## SBA-EMP-003 — Employment Verification\\nEmployer named on the loan application must match third-party employment verification letters. Mismatches are treated as potential fraud indicators.\\n\\n## GENERAL-001 — Default Review Threshold\\nAny high-severity fraud indicator automatically routes to manual underwriting review. Auto-decline is disabled in advisory mode.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/policies/json",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "policies", "json"]
            },
            "description": "Recommended for Postman — no file attachment needed. Returns 201."
          },
          "response": []
        },
        {
          "name": "Upload Policy (SBA seed — multipart file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('policyId', j.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
